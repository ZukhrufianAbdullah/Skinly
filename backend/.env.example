# ============================================================
# Skinly Backend - Konfigurasi Environment
# Salin file ini menjadi .env dan sesuaikan nilainya
# ============================================================

# --- Database MySQL (Laragon/XAMPP) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=skinly

# --- Database Test (terpisah agar data asli tidak tersentuh) ---
DB_TEST_NAME=skinly_test

# --- Upload Settings ---
MAX_UPLOAD_SIZE_MB=8
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
UPLOAD_DIR=uploads

# --- Validasi Citra (Image Quality Thresholds) ---
# Rata-rata brightness minimum (0-255); di bawah ini dianggap terlalu gelap
MIN_BRIGHTNESS=40
# Variance of Laplacian minimum; di bawah ini dianggap buram
MIN_SHARPNESS=80
# Apakah validasi wajah diaktifkan (true/false)
FACE_DETECTION_ENABLED=true

# --- Model ML ---
MODEL_PATH=app/ml/skin_model.keras
CLASS_NAMES_PATH=app/ml/class_names.json

# --- Aplikasi ---
APP_ENV=development
ALLOWED_ORIGINS=*

# --- Autentikasi / JWT ---
JWT_SECRET_KEY=skinly-super-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

